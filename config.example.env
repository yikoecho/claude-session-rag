# Embedding service (required for build_index.py and search_server.py)
EMBEDDING_API_KEY=your_key_here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# Storage paths
SESSION_ARCHIVE_PATH=./data/session_archive.md
SESSION_INDEX_PATH=./data/session_index.jsonl
LANCEDB_PATH=./data/lancedb

# Search server
SEARCH_SERVER_PORT=15200

# Optional: path to Claude Code project .jsonl files for grep fallback on raw history
# JSONL_DIR=/path/to/.claude/projects/your-project

# Optional: OpenRouter API key for Haiku recall filter
# Without this, /recall endpoint passes candidates through unchanged (still works, just less precise)
# OPENROUTER_API_KEY=your_key_here
# RECALL_MODEL=anthropic/claude-haiku-4-5

# Optional: model for entity extraction (enrich_entities.py)
# ENRICH_MODEL=anthropic/claude-haiku-4-5
