# ── Embedding ──────────────────────────────────────────────────────────────────
EMBEDDING_API_KEY=sk-your-key-here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ── Paths ──────────────────────────────────────────────────────────────────────
# LanceDB database directory (default: <repo>/memory_db)
# LANCE_DB_PATH=/path/to/memory_db

# Directory containing *.jsonl conversation archives (default: ~/.claude/projects/-root)
# JSONL_DIR=/path/to/projects/-root

# session_archive.md used by BM25 index (default: ~/.claude/session_archive.md)
# Optional — leave unset or point to a non-existent path to skip the archive
# layer entirely. The BM25 index will still be built from session_index.jsonl.
# ARCHIVE_FILE=/path/to/session_archive.md

# session_index.jsonl used by BM25 index (default: ~/.claude/session_index.jsonl)
# JSONL_INDEX_FILE=/path/to/session_index.jsonl

# ── Server ─────────────────────────────────────────────────────────────────────
# Port the search server listens on (default: 15200)
# SEARCH_PORT=15200

# ── Recall Agent (optional) ────────────────────────────────────────────────────
# API key for LLM-based query rewrite and stop-hook summarization.
# Supports OpenRouter (default) or any OpenAI-compatible endpoint.
# RECALL_API_KEY=your_key_here        # 旧变量，仍可用（向后兼容）
# RECALL_BASE_URL=https://openrouter.ai/api/v1   # 旧变量，仍可用
# RECALL_MODEL=anthropic/claude-haiku-4-5

# LLM 后端选择
# none: 零配置，纯检索，无 LLM 加持（默认）
# siliconflow: 免费远程 API，需配 SILICONFLOW_API_KEY（或复用 EMBEDDING_API_KEY）
# ollama: 本地免费，需先 ollama pull Qwen/Qwen3-8B
# api: 任意 OpenAI 兼容接口（OpenRouter / Anthropic 直连 / 其他）
# openrouter: 同 api，旧名称保留向后兼容
LLM_BACKEND=none
# SILICONFLOW_API_KEY=your_key_here   # 复用 EMBEDDING_API_KEY 也可以
# LLM_API_KEY=your_key_here           # api 模式用
# LLM_BASE_URL=https://openrouter.ai/api/v1
# RECALL_MODEL=anthropic/claude-haiku-4-5
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# ── BM25 tuning ────────────────────────────────────────────────────────────────
# Minimum BM25 score for an entity hit to claim a guaranteed result slot.
# This is empirically tuned for the author's corpus (~780 entities, Chinese).
# If you see irrelevant entity hits, raise it; if named entities disappear, lower it.
# BM25_ENTITY_MIN_SCORE=7.0

# ── Query Rewrite (hooks/recall_keywords.py) ───────────────────────────────────
# Set to true to enable LLM-based query rewriting in recall_keywords.py.
# When enabled, the last 3 conversation turns are sent to RECALL_MODEL to
# produce a condensed search query instead of raw jieba keyword extraction.
# Requires RECALL_API_KEY. Leave false to use jieba-only (no LLM cost).
# QUERY_REWRITE_ENABLED=false
#
# Optional: path to a jsonl file of recent conversation turns for context.
# Each line: {"role": "user"|"assistant", "content": "..."}
# CONTEXT_FILE=/path/to/recent_turns.jsonl
