# ── Embedding ──────────────────────────────────────────────────────────────────
EMBEDDING_API_KEY=sk-your-key-here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ── Paths ──────────────────────────────────────────────────────────────────────
# LanceDB database directory (default: <repo>/memory_db)
# LANCE_DB_PATH=/path/to/memory_db

# Directory containing *.jsonl conversation archives (default: ~/.claude/projects/-root)
# JSONL_DIR=/path/to/projects/-root

# session_archive.md used by BM25 index (default: ~/.claude/session_archive.md)
# ARCHIVE_FILE=/path/to/session_archive.md

# session_index.jsonl used by BM25 index (default: ~/.claude/session_index.jsonl)
# JSONL_INDEX_FILE=/path/to/session_index.jsonl

# ── Server ─────────────────────────────────────────────────────────────────────
# Port the search server listens on (default: 15200)
# SEARCH_PORT=15200

# ── Recall Agent (optional) ────────────────────────────────────────────────────
# OPENROUTER_API_KEY=your_key_here
# RECALL_MODEL=anthropic/claude-haiku-4-5
